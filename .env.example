# ------------------------------------------------------------------
# Django
# ------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_TIME_ZONE=UTC

# Comma-separated hostnames/IPs.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed to submit CSRF-protected
# requests. Include your real HTTPS domain in production.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=shop
DATABASE_USER=shop
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# ------------------------------------------------------------------
# Oscar/store
# ------------------------------------------------------------------
OSCAR_DEFAULT_CURRENCY=ریال

# True only when you intentionally want development-only pending
# orders before a payment provider is integrated.
CHECKOUT_ALLOW_PENDING_ORDERS=False

# ------------------------------------------------------------------
# Production security
# ------------------------------------------------------------------
# Development default. Set True/31536000 only in production behind HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0
